{
  "$description": "Single source of truth for colours, shared by the Python plotting theme and the Next.js dashboard. Categorical order and steps are the validated reference palette (dataviz skill); do not edit hexes without re-running the validator.",
  "font": {
    "family": [
      "Inter",
      "Helvetica Neue",
      "Arial",
      "system-ui",
      "sans-serif"
    ]
  },
  "light": {
    "surface": "#fcfcfb",
    "page": "#f9f9f7",
    "ink": {
      "primary": "#0b0b0b",
      "secondary": "#52514e",
      "muted": "#898781"
    },
    "grid": "#e1e0d9",
    "axis": "#c3c2b7",
    "categorical": [
      "#2a78d6",
      "#eb6834",
      "#1baf7a",
      "#eda100",
      "#e87ba4",
      "#008300",
      "#6250d6",
      "#e34948"
    ]
  },
  "dark": {
    "surface": "#1a1a19",
    "page": "#0d0d0d",
    "ink": {
      "primary": "#f0efec",
      "secondary": "#c3c2b7",
      "muted": "#898781"
    },
    "grid": "#2c2c2a",
    "axis": "#383835",
    "categorical": [
      "#3987e5",
      "#d95926",
      "#199e70",
      "#c98500",
      "#d55181",
      "#008300",
      "#9085e9",
      "#e66767"
    ]
  },
  "semantic": {
    "$note": "Fixed meaning across the project: index into the categorical list (slot number, 1-based) so light/dark both resolve.",
    "electricity": 1,
    "gas": 2,
    "agile": 3,
    "solar_export": 4,
    "net_electricity": 7,
    "vulnerable": 8,
    "comparator": 7,
    "electric_heating": 1,
    "gas_heating": 2,
    "flat_tariff": "muted"
  },
  "sequential_blue": {
    "100": "#cde2fb",
    "150": "#b7d3f6",
    "200": "#9ec5f4",
    "250": "#86b6ef",
    "300": "#6da7ec",
    "350": "#5598e7",
    "400": "#3987e5",
    "450": "#2a78d6",
    "500": "#256abf",
    "550": "#1c5cab",
    "600": "#184f95",
    "650": "#104281",
    "700": "#0d366b"
  },
  "ordinal_years": {
    "light": {
      "2020": "#86b6ef",
      "2021": "#5598e7",
      "2022": "#2a78d6",
      "2023": "#1c5cab",
      "2024": "#104281"
    },
    "dark": {
      "2020": "#184f95",
      "2021": "#256abf",
      "2022": "#3987e5",
      "2023": "#6da7ec",
      "2024": "#9ec5f4"
    },
    "$note": "later = more emphasis: darker on light surfaces, lighter on dark; light end >= step 250 (light) / dark end <= step 600 (dark)"
  },
  "diverging": {
    "negative": "#2a78d6",
    "neutral_light": "#f0efec",
    "neutral_dark": "#383835",
    "positive": "#e34948"
  },
  "status": {
    "good": "#0ca30c",
